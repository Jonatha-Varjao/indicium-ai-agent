# =============================================================================
# SRAG Surveillance Report Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# All settings are loaded via config/settings.py (Pydantic BaseSettings).
# Reference: docs/srag-poc-architecture-plan.md
# =============================================================================

# --- LLM Provider ---
# Google Gemini API key (Google AI Studio free tier).
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# --- News Retrieval ---
# Tavily API key for curated news search constrained to domain allowlist.
# https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# --- Observability ---
# Langfuse for LLM/agent tracing.
# Self-hosted via docker compose --profile observability.
# Keys match docker-compose.yml LANGFUSE_INIT_* values (auto-created on first run).
# If not configured, tracing is disabled (pipeline continues).
LANGFUSE_PUBLIC_KEY=pk-lf-srag-agent-local
LANGFUSE_SECRET_KEY=sk-lf-srag-agent-local
LANGFUSE_HOST=http://localhost:3000

# --- Pipeline Behavior ---
# "live"  — check DATASUS/CKAN freshness, download if newer
# "pinned" — use committed reproducibility snapshot (default, demo-safe)
DATA_MODE=pinned

# --- LLM Model ---
LLM_MODEL=gemini-3.1-flash-lite

# --- LLM Temperature ---
# Lower = more deterministic narrative. Range 0.0-1.0.
LLM_TEMPERATURE=0.2

# --- Timezone  ---
TIMEZONE=America/Sao_Paulo
